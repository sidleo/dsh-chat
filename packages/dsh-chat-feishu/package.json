{
  "name": "@sidleo3/dsh-chat-feishu",
  "version": "0.1.0",
  "type": "module",
  "description": "dsh-chat 飞书渠道插件（凭据、长连接、私聊/群聊、任务过程展示）",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "host",
    "client",
    "cordis.patch.yml",
    "package.json"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidleo/dsh-chat.git",
    "directory": "packages/dsh-chat-feishu"
  },
  "homepage": "https://github.com/sidleo/dsh-chat#readme",
  "bugs": {
    "url": "https://github.com/sidleo/dsh-chat/issues"
  }
}
